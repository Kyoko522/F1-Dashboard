# Environment variable template — copy to .env and fill in values. Never commit .env.

# Directory where FastF1 caches downloaded session data (defaults to /tmp/fastf1_cache)
FASTF1_CACHE_DIR=/tmp/fastf1_cache

# Allowed CORS origin for the frontend (e.g. http://localhost:5173 or production URL)
CORS_ORIGIN=http://localhost:5173
